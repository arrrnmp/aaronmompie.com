---
import { getCollection } from "astro:content";
import PostList from "../../../components/PostList.astro";
import Site from "../../../layouts/Site.astro";
import { slugify } from "../../../utils/slug";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	// Group by slug so "Home Lab" and "home-lab" share one page; show the first spelling seen.
	const tags = new Map<string, string>();
	for (const tag of posts.flatMap((p) => p.data.tags)) {
		if (!tags.has(slugify(tag))) tags.set(slugify(tag), tag);
	}
	return [...tags].map(([slug, tag]) => ({
		params: { tag: slug },
		props: {
			tag,
			posts: posts
				.filter((p) => p.data.tags.some((t) => slugify(t) === slug))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag, posts } = Astro.props;
---

<Site title={`Posts tagged: ${tag}`} description={`Blog posts tagged with "${tag}".`}>
	<section class="page-hero">
		<a class="back" href="/blog/">← All writing</a>
		<span class="lbl">Tag</span>
		<h1 class="cond page-title">{tag}.</h1>
	</section>
	<section class="sec" style="padding-top: 56px">
		<PostList posts={posts} />
	</section>
</Site>
