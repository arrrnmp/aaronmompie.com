---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../../components/BaseHead.astro";
import Footer from "../../../components/Footer.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import Header from "../../../components/Header.astro";
import { slugify } from "../../../utils/slug";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	// Group by slug so "Home Lab" and "home-lab" share one page; show the first spelling seen.
	const tags = new Map<string, string>();
	for (const tag of posts.flatMap((p) => p.data.tags)) {
		if (!tags.has(slugify(tag))) tags.set(slugify(tag), tag);
	}
	return [...tags].map(([slug, tag]) => ({
		params: { tag: slug },
		props: {
			tag,
			posts: posts
				.filter((p) => p.data.tags.some((t) => slugify(t) === slug))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Posts tagged: ${tag}`}
			description={`Blog posts tagged with "${tag}".`}
		/>
	</head>
	<body>
		<a href="#main" class="sr-only skip-link">Skip to content</a>
		<Header />
		<main id="main" class="site-main">
			<section class="section page-hero">
				<div class="container">
					<a href="/blog/">&larr; All posts</a>
					<h1>Posts tagged: {tag}</h1>
				</div>
			</section>

			<section class="section">
				<div class="container post-list-grid">
					{
						posts.map((post) => (
							<a
								href={`/blog/${post.id}/`}
								class="post-list-item surface-soft"
							>
								{post.data.heroImage && (
									<div class="post-list-media">
										<Picture
											width={720}
											height={400}
											src={post.data.heroImage}
											alt={post.data.title}
											formats={["avif", "webp"]}
											sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 720px"
											transition:name={`post-image-${post.id}`}
										/>
									</div>
								)}
								<div class="post-list-content">
									<p class="post-list-meta">
										<FormattedDate
											date={post.data.pubDate}
										/>
									</p>
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
								</div>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
