---
import { getCollection } from "astro:content";
import PostList from "../../components/PostList.astro";
import Site from "../../layouts/Site.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Site title="Writing" description="Essays and notes on systems, software, and the rest.">
	<section class="page-hero">
		<a class="back" href="/">← Back home</a>
		<span class="lbl">Writing</span>
		<h1 class="cond page-title">Writing.</h1>
		<p class="page-lead">Whatever I'm trying to understand: systems, people, and the parts that don't fit on a CV.</p>
	</section>
	<section class="sec" style="padding-top: 56px">
		<PostList posts={posts} />
	</section>
</Site>
