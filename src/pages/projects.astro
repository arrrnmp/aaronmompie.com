---
import { getCollection, render } from "astro:content";
import Site from "../layouts/Site.astro";

const projects = await Promise.all(
	(await getCollection("projects", ({ data }) => !data.draft))
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (entry) => ({ ...entry.data, id: entry.id, Content: (await render(entry)).Content })),
);
---

<Site title="Work" description="Everything I've built, with the stack and the reasoning behind it.">
	<section class="page-hero">
		<a class="back" href="/">← Back home</a>
		<span class="lbl">Work · every project</span>
		<h1 class="cond page-title">Work.</h1>
		<p class="page-lead">Infrastructure first. Software when the problem asks for it.</p>
	</section>
	<section class="sec" style="padding-top: 56px">
		<div class="work-list">
			{
				projects.map((p, i) => (
					<article class="work-row" id={p.id}>
						<span class="n">{String(i + 1).padStart(2, "0")}</span>
						<div>
							<h2>{p.title}</h2>
							<div class="role">{p.role}</div>
							<div class="stack">{p.techStack.join(" · ")}</div>
						</div>
						<div class="body">
							<p.Content />
							<div class="links">
								{p.url && <a href={p.url}>Live ↗</a>}
								{p.github && <a href={p.github}>Source ↗</a>}
								{!p.url && !p.github && <span class="lbl">Release coming soon</span>}
							</div>
						</div>
					</article>
				))
			}
		</div>
	</section>
</Site>
