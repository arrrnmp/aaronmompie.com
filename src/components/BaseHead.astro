---
import "../styles/global.css";
import { Font } from "astro:assets";
import type { ImageMetadata } from "astro";
import { SITE_TITLE, SITE_TWITTER_HANDLE } from "../consts";
import { alternate, isShared, langFromUrl, pageFromPath } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
	title: string;
	description: string;
	/** A page-specific share image (a blog post's hero); otherwise the page's own card from /og/. */
	image?: ImageMetadata;
	imageAlt?: string;
	type?: "website" | "article";
	publishedTime?: Date;
	modifiedTime?: Date;
	/** Keep the page out of search results (404, an empty blog). */
	noindex?: boolean;
}

const {
	title,
	description,
	image,
	imageAlt,
	type = "website",
	publishedTime,
	modifiedTime,
	noindex = false,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const lang = langFromUrl(Astro.url);
const ui = t(lang);
const canonicalURL = new URL(Astro.url.pathname, site);
const fullTitle = title.startsWith(SITE_TITLE) ? title : `${title} | ${SITE_TITLE}`;
const imageURL = new URL(image ? image.src : `/og/${lang}/${pageFromPath(Astro.url.pathname) ?? "home"}.png`, site);
const ogImageAlt = imageAlt ?? (image ? fullTitle : ui.meta.shareAlt);
const altLocale = t(lang === "en" ? "es" : "en").meta.locale;
const hrefIn = (l: "en" | "es") => new URL(alternate(Astro.url.pathname, l), site);
// Browser UI colour follows the page background (dark first, like tokens.css).
const THEME_COLOR = { dark: "#0b0b0c", light: "#f1efe9" };
---

<meta name="theme-color" content={THEME_COLOR.dark} data-dark={THEME_COLOR.dark} data-light={THEME_COLOR.light} />
<!-- Theme before first paint: the saved choice, else the device setting. The browser bar colour follows it. -->
<script is:inline>
	(function () {
		var root = document.documentElement, saved = null;
		var bar = document.querySelector('meta[name="theme-color"]');
		var paint = function () { if (bar) bar.content = bar.dataset[root.dataset.theme] || bar.content; };
		try { saved = localStorage.getItem("theme"); } catch (e) {}
		var mq = matchMedia("(prefers-color-scheme: light)");
		root.dataset.theme = saved || (mq.matches ? "light" : "dark");
		paint();
		new MutationObserver(paint).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
		if (!saved) mq.addEventListener("change", function (e) {
			var stored = null;
			try { stored = localStorage.getItem("theme"); } catch (err) {}
			if (!stored) root.dataset.theme = e.matches ? "light" : "dark";
		});
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="color-scheme" content="dark light" />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL("/rss.xml", site)} />
<meta name="generator" content={Astro.generator} />

<!-- Self-hosted fonts (configured in astro.config.mjs) -->
<Font cssVariable="--font-unbounded" preload={[{ subset: "latin" }]} />
<Font cssVariable="--font-big-shoulders" preload={[{ subset: "latin" }]} />
<Font cssVariable="--font-instrument-sans" preload={[{ style: "normal", subset: "latin" }]} />

<!-- Canonical URL, and the same page in the other language -->
<link rel="canonical" href={canonicalURL} />
{
	isShared(Astro.url.pathname) && (
		<>
			<link rel="alternate" hreflang="en" href={hrefIn("en")} />
			<link rel="alternate" hreflang="es" href={hrefIn("es")} />
			<link rel="alternate" hreflang="x-default" href={hrefIn("en")} />
		</>
	)
}

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_TITLE} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{!image && <meta property="og:image:type" content="image/png" />}
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ui.meta.locale} />
{isShared(Astro.url.pathname) && <meta property="og:locale:alternate" content={altLocale} />}
{type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === "article" && <meta property="article:author" content={new URL("/about/", site).toString()} />}

<!-- X (Twitter) -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_TWITTER_HANDLE} />
<meta name="twitter:creator" content={SITE_TWITTER_HANDLE} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={ogImageAlt} />
