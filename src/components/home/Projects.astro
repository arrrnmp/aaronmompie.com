---
import { getCollection } from "astro:content";

const all = (await getCollection("projects", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const featured = all.find((p) => p.data.featured);
const rest = all.filter((p) => p !== featured);
---

<section class="sec" id="work">
	<div class="sechead"><h2 class="cond h2">Projects</h2><a class="more" href="/projects" style="margin: 0">All the details ↗</a></div>
	{
		featured && (
			<article class="feature">
				<div>
					<div class="lbl">Featured · {featured.data.url || featured.data.github ? "live" : "in progress"}</div>
					<h3 class="cond" style="margin-top: 10px">{featured.data.title}</h3>
				</div>
				<div>
					<p>{featured.body?.trim()}</p>
					<div class="chips">{featured.data.techStack.map((t) => <span>{t}</span>)}</div>
					{featured.data.url || featured.data.github ? (
						<a href={featured.data.url ?? featured.data.github}>{featured.data.url ? "Open it ↗" : "Source ↗"}</a>
					) : (
						<p class="lbl" style="margin: 22px 0 0">Release coming soon</p>
					)}
				</div>
			</article>
		)
	}
	<div class="cards">
		{
			rest.map((p, i) => (
				<article class="card">
					<span class="n">{String(i + 1).padStart(2, "0")}</span>
					<h3>{p.data.title}</h3>
					<p>{p.data.description}</p>
					<span class="stack">{p.data.techStack.join(" · ")}</span>
					{(p.data.url || p.data.github) && <a href={p.data.url ?? p.data.github}>{p.data.url ? "Live" : "Source"} ↗</a>}
				</article>
			))
		}
	</div>
</section>
