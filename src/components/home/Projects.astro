---
import { getCollection } from "astro:content";
import { langFromUrl, path } from "../../i18n/routes";
import { t } from "../../i18n/ui";

const lang = langFromUrl(Astro.url);
const ui = t(lang).projects;
const all = (await getCollection("projects", ({ data }) => !data.draft))
	.sort((a, b) => a.data.order - b.data.order)
	.map((p) => {
		const es = lang === "es" ? p.data.es : undefined;
		return {
			...p.data,
			description: es?.description ?? p.data.description,
			long: es?.long ?? p.body?.trim() ?? "",
			techStack: es?.techStack ?? p.data.techStack,
		};
	});
const featured = all.find((p) => p.featured);
const rest = all.filter((p) => p !== featured);
---

<section class="sec" id="work">
	<div class="sechead"><h2 class="cond h2">{ui.title}</h2><a class="more" href={path("work", lang)} style="margin: 0">{ui.all}</a></div>
	{
		featured && (
			<article class="feature">
				<div>
					<div class="lbl">{ui.featured} · {featured.url || featured.github ? ui.live : ui.inProgress}</div>
					<h3 class="cond" style="margin-top: 10px">{featured.title}</h3>
				</div>
				<div>
					<p>{featured.long}</p>
					<div class="chips">{featured.techStack.map((s) => <span>{s}</span>)}</div>
					{featured.url || featured.github ? (
						<a href={featured.url ?? featured.github}>{featured.url ? ui.open : `${ui.source} ↗`}</a>
					) : (
						<p class="lbl" style="margin: 22px 0 0">{ui.soon}</p>
					)}
				</div>
			</article>
		)
	}
	<div class="cards">
		{
			rest.map((p, i) => (
				<article class="card">
					<span class="n">{String(i + 1).padStart(2, "0")}</span>
					<h3>{p.title}</h3>
					<p>{p.description}</p>
					<span class="stack">{p.techStack.join(" · ")}</span>
					{(p.url || p.github) && <a href={p.url ?? p.github}>{p.url ? ui.liveLink : ui.source} ↗</a>}
				</article>
			))
		}
	</div>
</section>
