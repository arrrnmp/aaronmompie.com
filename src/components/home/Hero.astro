---
import { SITE_TITLE } from "../../consts";
import { langFromUrl } from "../../i18n/routes";
import { t } from "../../i18n/ui";

const ui = t(langFromUrl(Astro.url));
const h = ui.hero;
---

<h1 class="name" id="name">{SITE_TITLE}</h1>

<section class="hero" aria-label={ui.nav.about}>
	<div class="panel">
		<canvas id="heroDots" role="img" aria-label={h.portrait}></canvas>
	</div>
	<div class="bill">
		<h2 class="cond role" style={`--chars: ${Math.max(...h.role.map((l) => l.length))}`}>{h.role[0]}<br />{h.role[1]}</h2>
		<p>{h.lede}</p>
		<p class="stance">{h.stance}</p>
		<div class="ctas">
			<a class="btn btn-blue" href="#contact">{h.hire}</a>
			<a class="btn btn-line" href="#work">{h.work}</a>
			<a class="btn btn-line" href={ui.meta.cv}>{h.cv}</a>
		</div>
	</div>
</section>

<div class="band">
	<div class="ticker">
		<p>{h.facts.map((f) => <Fragment>{f}<i aria-hidden="true">✶</i></Fragment>)}</p>
		<p aria-hidden="true">{h.facts.map((f) => <Fragment>{f}<i>✶</i></Fragment>)}</p>
	</div>
</div>

<script>
	import { compact, DotField } from "../../scripts/dot-field";

	const phone = compact.matches;
	new DotField(document.getElementById("heroDots") as HTMLCanvasElement, "/media/head-density.png", {
		count: phone ? 7000 : 15000,
		stillCount: phone ? 24000 : 40000,
		baseAlpha: 0.7,
		color: "#ffffff",
		bg: "#2b3bff",
		speed: 0.32,
		fit: 0.96,
		photo: "/media/head-photo.webp",
	});
</script>
