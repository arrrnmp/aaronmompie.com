---
import { ORIGIN } from "../../data/experience";
---

<section class="sec" id="sides">
	<div class="sechead"><h2 class="cond h2">Two sides</h2></div>
	<div class="sides">
		<div>
			<div class="deck" id="deck">
				<button type="button" class="sleeve" id="sleeve" aria-label="Flip the record to side B"><canvas id="cover" aria-hidden="true"></canvas></button>
				<div class="record" aria-hidden="true">
					<div class="spinner"><div class="disc"></div><div class="label"><canvas id="labelArt"></canvas></div></div>
					<div class="sheen"></div>
					<div class="hole"></div>
				</div>
				<div class="arm" aria-hidden="true">
					<svg viewBox="0 0 160 380">
						<defs><linearGradient id="metal" x1="0" x2="1"><stop offset="0" stop-color="#85858d"></stop><stop offset=".5" stop-color="#f4f4f7"></stop><stop offset="1" stop-color="#9a9aa2"></stop></linearGradient></defs>
						<rect x="104" y="4" width="28" height="34" rx="6" fill="url(#metal)"></rect>
						<line x1="104" y1="15" x2="132" y2="15" stroke="#6f6f77" stroke-width="1.5"></line>
						<line x1="104" y1="27" x2="132" y2="27" stroke="#6f6f77" stroke-width="1.5"></line>
						<rect x="114" y="36" width="8" height="18" fill="#c9c9cf"></rect>
						<circle cx="118" cy="62" r="34" fill="#1d1d21" stroke="#3b3b42" stroke-width="3"></circle>
						<circle cx="118" cy="62" r="20" fill="url(#metal)"></circle>
						<circle cx="118" cy="62" r="7" fill="#2a2a2e"></circle>
						<path d="M118 62 L110 270" fill="none" stroke="url(#metal)" stroke-width="7" stroke-linecap="round"></path>
						<path d="M110 270 L94 312" fill="none" stroke="url(#metal)" stroke-width="7" stroke-linecap="round"></path>
						<g transform="rotate(22 90 320)">
							<rect x="75" y="306" width="30" height="26" rx="3" fill="#ececef"></rect>
							<rect x="81" y="331" width="18" height="10" rx="2" fill="#18181c"></rect>
							<line x1="105" y1="312" x2="120" y2="305" stroke="#ececef" stroke-width="3" stroke-linecap="round"></line>
						</g>
					</svg>
				</div>
			</div>
			<p class="flip-hint">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"></path><path d="M3 21v-5h5"></path></svg>
				<span id="hint">Tap the cover to flip to Side B</span>
			</p>
		</div>

		<div class="panels">
			<div class="side-panel" id="panelA">
				<span class="lbl">Side A · Origin</span>
				<h3 class="cond">Online since six.</h3>
				<ol class="tl">
					{ORIGIN.map(({ age, text }) => <li><span class="k">{age}</span><span class="v">{text}</span></li>)}
				</ol>
				<a class="more" href="/about">Read the full story ↗</a>
			</div>
			<div class="side-panel is-hidden" id="panelB" inert aria-hidden="true">
				<span class="lbl">Side B · Studio</span>
				<h3 class="cond">In the studio.</h3>
				<p>Learning to produce music and to sing. Early days, solid foundations. This one has no words yet.</p>
				<div class="player">
					<button class="play" id="play" type="button" aria-label="Play “it's complicated”">
						<svg id="playIcon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
					</button>
					<div><div class="tt">it's complicated</div><div class="tm">Aaron Mompié · Instrumental demo · 2026</div></div>
					<div class="wave">
						<canvas id="wave" aria-hidden="true"></canvas>
						<input id="seek" type="range" min="0" max="1000" value="0" step="1" aria-label="Seek in “it's complicated”" />
					</div>
					<div class="times"><span id="cur">0:00</span><span id="dur">–:––</span></div>
				</div>
				<p>Also on this side: my first essay, on being present and on nostalgia. Coming soon.</p>
				<audio id="audio" src="/media/its-complicated.mp3" preload="metadata"></audio>
			</div>
		</div>
	</div>
</section>

<script>
	import { initRecord } from "../../scripts/record";
	initRecord();
</script>
