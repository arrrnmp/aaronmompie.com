---
import { langFromUrl } from "../../i18n/routes";
import { t } from "../../i18n/ui";

const ui = t(langFromUrl(Astro.url)).experience;
---

<section class="sec" id="experience">
	<div class="sechead"><h2 class="cond h2">{ui.title}</h2></div>
	{
		ui.jobs.map((job) => (
			<article class="job">
				<div class="when">
					<div class="yr">{job.when}</div>
					<span class:list={["badge", { on: job.kind === "now" }]}>{ui.badges[job.kind]}</span>
				</div>
				<div>
					<h3 class="co">{job.org}</h3>
					<div class="ro">{job.role}</div>
					{job.note && <div class="note">{job.note}</div>}
				</div>
				<ul class="did">
					{job.did.map((d) => <li set:html={d} />)}
				</ul>
			</article>
		))
	}
</section>
