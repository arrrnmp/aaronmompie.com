---
import { SITE_GITHUB_URL, SITE_LINKEDIN_URL, SITE_TITLE, SITE_X_URL } from "../consts";
import { langFromUrl } from "../i18n/routes";
import { t } from "../i18n/ui";

const lang = langFromUrl(Astro.url);
const ui = t(lang);
const year = new Date().getFullYear();
---

<!-- Fixed behind the page; revealed as the page scrolls away. -->
<footer class="finale" id="contact">
	<div class="finale-wrap" id="finaleWrap">
		<div class="finale-in">
			<div>
				<div class="lbl">{ui.finale.label}</div>
				<h2 class="cond" style={`--chars: ${ui.finale.title.length}`}>{ui.finale.title}</h2>
				<a class="mail" href={`mailto:${ui.meta.email}`} id="mail">{ui.meta.email}</a>
				<div class="biglinks">
					<a href={SITE_LINKEDIN_URL} rel="noreferrer" target="_blank">LinkedIn</a>
					<a href={SITE_GITHUB_URL} rel="noreferrer" target="_blank">GitHub</a>
					<a href={SITE_X_URL} rel="noreferrer" target="_blank">X</a>
					<a href={ui.meta.cv}>{ui.finale.cv}</a>
				</div>
			</div>
			<div class="pose">
				<canvas id="poseDots" role="img" aria-label={ui.finale.pose}></canvas>
			</div>
		</div>
		<div class="fine"><span>© {year} {SITE_TITLE}</span><span>{ui.finale.place}</span></div>
	</div>
</footer>

<script>
	import { DotField, reducedMotion } from "../scripts/dot-field";

	const phone = innerWidth < 820;
	new DotField(document.getElementById("poseDots") as HTMLCanvasElement, "/media/body-density.png", {
		count: phone ? 4000 : 8000,
		stillCount: phone ? 12000 : 24000,
		baseAlpha: 0.7,
		color: "#ffffff",
		bg: "#2b3bff",
		speed: 0.28,
		fit: 1,
		photo: "/media/body-photo.webp",
	});

	// The footer slides up and fades in as the page lifts off it.
	const sheet = document.getElementById("sheet")!;
	const wrap = document.getElementById("finaleWrap")!;
	function reveal() {
		const p = Math.max(0, Math.min(1, (innerHeight - sheet.getBoundingClientRect().bottom) / innerHeight));
		const still = reducedMotion.matches;
		wrap.style.setProperty("--lift", still ? "0%" : `${(1 - p) * 14}%`);
		wrap.style.setProperty("--fade", String(still ? (p > 0.05 ? 1 : 0) : Math.min(1, p * 1.6)));
	}
	addEventListener("scroll", reveal, { passive: true });
	addEventListener("resize", reveal);
	reveal();

	// "#contact" links scroll to the very bottom, where the footer is fully revealed.
	document.querySelectorAll<HTMLAnchorElement>('a[href="#contact"]').forEach((a) =>
		a.addEventListener("click", (e) => {
			e.preventDefault();
			scrollTo({ top: document.documentElement.scrollHeight, behavior: reducedMotion.matches ? "auto" : "smooth" });
		}),
	);
</script>
