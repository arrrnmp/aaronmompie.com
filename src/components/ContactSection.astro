---
import { SITE_EMAIL } from "../consts";

interface Props {
	/** Section number shown in the eyebrow, e.g. "02". */
	number: string;
}

const { number } = Astro.props;
---

<section class="section">
	<div class="container reveal">
		<div class="section-header">
			<span class="eyebrow"><span class="num">§ {number}</span>Contact</span>
		</div>
		<div class="contact-fit">
			<a href={`mailto:${SITE_EMAIL}`} class="contact-huge">
				{SITE_EMAIL}<span class="caret" aria-hidden="true"></span>
			</a>
		</div>
	</div>
</section>
