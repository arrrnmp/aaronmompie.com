---
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../consts";
import { isActivePath } from "../utils/nav";

const hasWriting = (await getCollection("blog", ({ data }) => !data.draft)).length > 0;

const links = [
	{ href: "/#work", label: "Work" },
	{ href: "/#experience", label: "Experience" },
	{ href: "/about", label: "About" },
	...(hasWriting ? [{ href: "/blog", label: "Writing" }] : []),
	{ href: "#contact", label: "Contact" },
];
const current = (href: string) => !href.includes("#") && isActivePath(Astro.url.pathname, href);
---

<header class="top" id="top">
	<a class="mark" href="/" aria-label={`${SITE_TITLE}, home`}>
		<span class="mono" aria-hidden="true">AM</span>
		<span class="mark-name" aria-hidden="true">{SITE_TITLE}</span>
	</a>
	<nav id="nav" aria-label="Primary">
		{links.map(({ href, label }) => <a href={href} aria-current={current(href) ? "page" : undefined}>{label}</a>)}
	</nav>
	<div class="right">
		<a class="btn btn-blue" href="#contact">Book me ↗</a>
		<button class="menu-btn" id="menu" type="button" aria-expanded="false" aria-controls="nav" aria-label="Open menu">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"></path><path d="M4 16h16"></path></svg>
		</button>
	</div>
</header>

<script>
	const top = document.getElementById("top")!;
	const nav = document.getElementById("nav")!;
	const menu = document.getElementById("menu")!;

	// On the home page the "AM" mark grows into the full name once the big name scrolls away.
	const name = document.getElementById("name");
	if (name) {
		new IntersectionObserver((es) => top.classList.toggle("is-scrolled", !es[0].isIntersecting), {
			rootMargin: "-60px 0px 0px 0px",
		}).observe(name);
	} else {
		top.classList.add("is-scrolled");
	}

	const setOpen = (open: boolean) => {
		nav.classList.toggle("is-open", open);
		menu.setAttribute("aria-expanded", String(open));
		menu.setAttribute("aria-label", open ? "Close menu" : "Open menu");
	};
	menu.addEventListener("click", () => setOpen(!nav.classList.contains("is-open")));
	nav.addEventListener("click", (e) => {
		if ((e.target as Element).closest("a")) setOpen(false);
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setOpen(false);
	});
</script>
