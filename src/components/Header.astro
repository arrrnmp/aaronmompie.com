---
import { getCollection } from "astro:content";
import { SITE_TITLE, SITE_EMAIL, SITE_LINKEDIN_URL, SITE_X_URL, SITE_INSTAGRAM_URL } from "../consts";
import { isActivePath } from "../utils/nav";
import HeaderLink from "./HeaderLink.astro";

const publishedPosts = await getCollection("blog", ({ data }) => !data.draft);
const hasWriting = publishedPosts.length > 0;

const navLinks = [
	{ href: "/", label: "Index" },
	{ href: "/projects", label: "Work" },
	...(hasWriting ? [{ href: "/blog", label: "Writing" }] : []),
	{ href: "/about", label: "About" },
];
---

<header class="site-header anim-fade-down" transition:persist>
	<nav class="nav-bar" aria-label="Primary">
		<a href="/" class="brand-name">{SITE_TITLE}</a>
		<div class="nav-links">
			{navLinks.map(({ href, label }) => <HeaderLink href={href}>{label}</HeaderLink>)}
		</div>
		<button
			class="nav-hamburger"
			aria-label="Open navigation menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<span class="nav-hamburger-bar"></span>
			<span class="nav-hamburger-bar"></span>
			<span class="nav-hamburger-bar"></span>
		</button>
	</nav>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true" transition:persist>
	<nav class="mobile-menu-nav" aria-label="Mobile navigation">
		{navLinks.map(({ href, label }) => (
			<a
				href={href}
				class:list={["mobile-nav-link", { "is-active": isActivePath(Astro.url.pathname, href) }]}
			>
				{label}
			</a>
		))}
	</nav>
	<a href={`mailto:${SITE_EMAIL}`} class="mobile-menu-email">{SITE_EMAIL}</a>
	<div class="mobile-menu-footer">
		<div class="mobile-menu-socials">
			<a href={SITE_LINKEDIN_URL} rel="noreferrer" target="_blank">LinkedIn</a>
			<a href={SITE_X_URL} rel="noreferrer" target="_blank">X</a>
			<a href={SITE_INSTAGRAM_URL} rel="noreferrer" target="_blank">Instagram</a>
		</div>
	</div>
</div>

<script>
	import { isActivePath } from "../utils/nav";

	const btn = document.querySelector<HTMLButtonElement>(".nav-hamburger");
	const menu = document.getElementById("mobile-menu");
	const header = document.querySelector(".site-header");

	// The header persists across view transitions, so the server-rendered
	// active state goes stale after the first navigation; recompute it.
	function updateActiveLinks() {
		const current = window.location.pathname;
		document.querySelectorAll<HTMLAnchorElement>(".nav-link").forEach((link) => {
			const active = isActivePath(current, link.getAttribute("href") ?? "/");
			link.classList.toggle("active", active);
			if (active) link.setAttribute("aria-current", "page");
			else link.removeAttribute("aria-current");
		});
		document.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link").forEach((link) => {
			link.classList.toggle("is-active", isActivePath(current, link.getAttribute("href") ?? "/"));
		});
	}

	function setMenuOpen(open: boolean) {
		btn?.setAttribute("aria-expanded", String(open));
		btn?.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
		menu?.classList.toggle("is-open", open);
		if (open) menu?.removeAttribute("aria-hidden");
		else menu?.setAttribute("aria-hidden", "true");
		header?.classList.toggle("menu-open", open);
	}

	btn?.addEventListener("click", () => setMenuOpen(!menu?.classList.contains("is-open")));

	updateActiveLinks();
	document.addEventListener("astro:page-load", updateActiveLinks);
	document.addEventListener("astro:before-swap", () => setMenuOpen(false));
</script>
