---
import { getCollection } from "astro:content";
import { SITE_GITHUB_URL, SITE_LINKEDIN_URL, SITE_TITLE, SITE_X_URL } from "../consts";
import { alternate, langFromUrl, path } from "../i18n/routes";
import { t } from "../i18n/ui";
import { isActivePath } from "../utils/nav";

const lang = langFromUrl(Astro.url);
const copy = t(lang);
const ui = copy.nav;
const other = lang === "en" ? "es" : "en";
const home = path("home", lang);
const hasWriting = (await getCollection("blog", ({ data }) => !data.draft)).length > 0;

const links = [
	{ href: `${home}#experience`, label: ui.experience },
	{ href: `${home}#work`, label: ui.work },
	{ href: `${home}#sides`, label: ui.about },
	...(hasWriting ? [{ href: "/blog/", label: ui.writing }] : []),
	{ href: "#contact", label: ui.contact },
];
const current = (href: string) => !href.includes("#") && isActivePath(Astro.url.pathname, href);
---

<header class="top" id="top">
	<a class="mark" href={home} aria-label={`${SITE_TITLE}, ${ui.home}`}>
		<span class="mono" aria-hidden="true">AM</span>
		<span class="mark-name" aria-hidden="true"><span>{SITE_TITLE}</span></span>
	</a>
	<nav id="nav" aria-label={ui.label}>
		{links.map(({ href, label }) => <a href={href} aria-current={current(href) ? "page" : undefined}>{label}</a>)}
	</nav>
	<div class="right">
		<button class="icon-btn theme-btn" id="themeBtn" type="button" data-to-light={ui.toLight} data-to-dark={ui.toDark} aria-label={ui.toLight}>
			<svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M4.2 4.2 6 6M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"></path></svg>
			<svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
		</button>
		<a class="icon-btn lang-btn" href={alternate(Astro.url.pathname, other)} hreflang={other} lang={other} aria-label={ui.langName}>{ui.langShort}</a>
		<a class="btn btn-blue" href="#contact">{ui.hire}</a>
		<button class="menu-btn" id="menu" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label={ui.openMenu} data-open={ui.openMenu} data-close={ui.closeMenu}>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"></path><path d="M4 16h16"></path></svg>
		</button>
	</div>
</header>

<!-- Phones and tablet portrait: a full-screen menu under the header. -->
<div class="mmenu" id="mobileMenu" hidden>
	<nav class="mmenu-nav" aria-label={ui.label}>
		{links.map(({ href, label }) => <a href={href} aria-current={current(href) ? "page" : undefined}>{label}</a>)}
	</nav>
	<a class="btn btn-blue mmenu-hire" href="#contact">{ui.hire}</a>
	<a class="mmenu-mail" href={`mailto:${copy.meta.email}`}>{copy.meta.email}</a>
	<div class="mmenu-foot">
		<a href={SITE_LINKEDIN_URL} rel="noreferrer" target="_blank">LinkedIn</a>
		<a href={SITE_GITHUB_URL} rel="noreferrer" target="_blank">GitHub</a>
		<a href={SITE_X_URL} rel="noreferrer" target="_blank">X</a>
		<a href={copy.meta.cv}>{copy.finale.cv}</a>
	</div>
</div>

<script>
	const top = document.getElementById("top")!;
	const mobileMenu = document.getElementById("mobileMenu")!;
	const menu = document.getElementById("menu")!;
	const themeBtn = document.getElementById("themeBtn")!;

	// On the home page the "AM" mark grows into the full name once the big name scrolls away.
	const name = document.getElementById("name");
	if (name) {
		new IntersectionObserver((es) => top.classList.toggle("is-scrolled", !es[0].isIntersecting), {
			rootMargin: "-60px 0px 0px 0px",
		}).observe(name);
	} else {
		top.classList.add("is-scrolled");
	}

	const setOpen = (open: boolean) => {
		if (open === !mobileMenu.hidden) return;
		mobileMenu.hidden = !open;
		document.documentElement.classList.toggle("menu-open", open);
		menu.setAttribute("aria-expanded", String(open));
		menu.setAttribute("aria-label", (open ? menu.dataset.close : menu.dataset.open) ?? "");
	};
	menu.addEventListener("click", () => setOpen(mobileMenu.hidden));
	mobileMenu.addEventListener("click", (e) => {
		if ((e.target as Element).closest("a")) setOpen(false);
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && !mobileMenu.hidden) {
			setOpen(false);
			menu.focus();
		}
	});
	// Close it when the layout goes back to the full nav, and when the page returns from the back/forward cache.
	matchMedia("(min-width: 821px)").addEventListener("change", (e) => e.matches && setOpen(false));
	addEventListener("pageshow", () => setOpen(false));

	// Theme: BaseHead sets data-theme before first paint; this button flips it and remembers the choice.
	const root = document.documentElement;
	const syncThemeLabel = () =>
		themeBtn.setAttribute("aria-label", (root.dataset.theme === "light" ? themeBtn.dataset.toDark : themeBtn.dataset.toLight) ?? "");
	themeBtn.addEventListener("click", () => {
		const next = root.dataset.theme === "light" ? "dark" : "light";
		root.dataset.theme = next;
		try {
			localStorage.setItem("theme", next);
		} catch {}
		syncThemeLabel();
	});
	new MutationObserver(syncThemeLabel).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
	syncThemeLabel();
</script>
