# Cloudflare Workers static-asset headers (https://developers.cloudflare.com/workers/static-assets/headers/).

# Built files have a content hash in their name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps its name when replaced: cache for a month, then check again.
/media/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
